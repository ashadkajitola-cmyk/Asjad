/* =========================================================
   UPDATE RANKING
========================================================= */

function updateRanking(){

    if(!requireSubscription()){
        return;
    }


    const format =
        document.getElementById(
            "rankingFormat"
        ).value;


    const team =
        document.getElementById(
            "rankingTeam"
        ).value.trim();


    const rating =
        Number(
            document.getElementById(
                "rankingRating"
            ).value
        );


    if(!team || !Number.isFinite(rating)){

        alert(
            "Team aur rating enter karein."
        );

        return;

    }


    let list;


    if(format==="test"){

        list=testTeams;

    }
    else if(format==="odi"){

        list=odiTeams;

    }
    else{

        list=t20Teams;

    }


    const existing =
        list.find(
            x => x[0].toLowerCase()
                === team.toLowerCase()
        );


    if(existing){

        existing[1]=rating;

    }
    else{

        list.push([
            team,
            rating
        ]);

    }


    if(format==="test"){

        localStorage.setItem(
            STORAGE.testTeams,
            JSON.stringify(list)
        );

    }

    else if(format==="odi"){

        localStorage.setItem(
            STORAGE.odiTeams,
            JSON.stringify(list)
        );

    }

    else{

        localStorage.setItem(
            STORAGE.t20Teams,
            JSON.stringify(list)
        );

    }


    renderRankings();


    document.getElementById(
        "rankingTeam"
    ).value="";

    document.getElementById(
        "rankingRating"
    ).value="";


    alert(
        "Ranking updated."
    );

}



/* =========================================================
   GROUP POINTS
========================================================= */

function populateGroupDropdown(){

    const select =
        document.getElementById(
            "pointsGroup"
        );


    select.innerHTML =
        groups.map(
            (g,i)=>`

            <option value="${i}">
                ${g.name}
            </option>

            `
        ).join("");

}



function updateGroupPoints(){

    if(!requireSubscription()){
        return;
    }


    const index =
        Number(
            document.getElementById(
                "pointsGroup"
            ).value
        );


    if(
        !groups[index]
    ){

        alert(
            "Pehle group create karein."
        );

        return;

    }


    const team =
        document.getElementById(
            "pointsTeam"
        ).value.trim();


    const p =
        Number(
            document.getElementById(
                "pointsPlayed"
            ).value
        );


    const w =
        Number(
            document.getElementById(
                "pointsWon"
            ).value
        );


    const l =
        Number(
            document.getElementById(
                "pointsLost"
            ).value
        );


    const nrr =
        Number(
            document.getElementById(
                "pointsNRR"
            ).value
        );


    if(!team){

        alert(
            "Team name enter karein."
        );

        return;

    }


    if(!groups[index].teams){
        groups[index].teams=[];
    }


    const existing =
        groups[index].teams.find(
            t =>
                t.team.toLowerCase()
                === team.toLowerCase()
        );


    const item={

        team:team,

        p:Number.isFinite(p)?p:0,

        w:Number.isFinite(w)?w:0,

        l:Number.isFinite(l)?l:0,

        pts:
            Number.isFinite(w)
            ?
            w*2
            :
            0,

        nrr:
            Number.isFinite(nrr)
            ?
            nrr
            :
            0

    };


    if(existing){

        Object.assign(
            existing,
            item
        );

    }
    else{

        groups[index].teams.push(
            item
        );

    }


    groups[index].teams.sort(
        (a,b)=>{

            if((b.pts||0)!==(a.pts||0)){
                return (b.pts||0)-(a.pts||0);
            }

            return (b.nrr||0)-(a.nrr||0);

        }
    );


    localStorage.setItem(
        STORAGE.groups,
        JSON.stringify(groups)
    );


    renderGroups();


    alert(
        "Points table updated."
    );

}



