<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cricket Central</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    background:#f3f5f7;
    color:#222;
}

.app{
    max-width:480px;
    margin:auto;
    min-height:100vh;
    background:#fff;
}

.header{
    background:#0b9e78;
    color:#fff;
    padding:18px 16px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.header h1{
    font-size:21px;
}

.header small{
    display:block;
    margin-top:4px;
    opacity:.9;
}

.admin-btn{
    background:#fff;
    color:#0b9e78;
    border:0;
    border-radius:8px;
    padding:9px 11px;
    font-weight:bold;
}

.tabs{
    display:flex;
    background:#fff;
    border-bottom:1px solid #ddd;
}

.tab{
    flex:1;
    text-align:center;
    padding:14px 4px;
    font-weight:bold;
    font-size:12px;
    cursor:pointer;
}

.tab.active{
    color:#0b9e78;
    border-bottom:3px solid #0b9e78;
}

.page{
    display:none;
    padding:14px;
}

.page.active{
    display:block;
}

.card{
    background:#fff;
    border-radius:12px;
    padding:15px;
    margin-bottom:12px;
    box-shadow:0 2px 10px rgba(0,0,0,.08);
}

.section-title{
    font-size:18px;
    font-weight:bold;
    margin-bottom:12px;
}

.match{
    border:1px solid #ddd;
    border-radius:12px;
    padding:14px;
    margin-bottom:12px;
}

.match-title{
    font-weight:bold;
    font-size:14px;
}

.teams{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:15px 0;
}

.team{
    width:42%;
    text-align:center;
    font-weight:bold;
}

.vs{
    font-weight:bold;
    color:#0b9e78;
}

.flag{
    width:38px;
    height:25px;
    object-fit:cover;
    display:block;
    margin:0 auto 6px;
    border-radius:3px;
}

.info{
    text-align:center;
    font-size:12px;
    color:#666;
}

table{
    width:100%;
    border-collapse:collapse;
    font-size:12px;
}

th{
    background:#0b9e78;
    color:#fff;
    padding:9px 5px;
}

td{
    padding:9px 5px;
    border-bottom:1px solid #eee;
    text-align:center;
}

td:nth-child(2){
    text-align:left;
    font-weight:bold;
}

input,select{
    width:100%;
    padding:11px;
    margin:6px 0 10px;
    border:1px solid #ccc;
    border-radius:8px;
    font-size:14px;
}

button{
    cursor:pointer;
}

.btn{
    width:100%;
    padding:12px;
    border:0;
    border-radius:8px;
    background:#0b9e78;
    color:white;
    font-weight:bold;
    margin-top:5px;
}

.btn.red{
    background:#e53935;
}

.btn.gray{
    background:#666;
}

.btn.gold{
    background:#e3a400;
}

.lock{
    text-align:center;
    padding:25px 15px;
}

.lock-icon{
    font-size:40px;
    margin-bottom:10px;
}

.lock h3{
    margin-bottom:7px;
}

.lock p{
    color:#666;
    font-size:13px;
    line-height:1.5;
}

.subscription-status{
    padding:12px;
    border-radius:9px;
    margin-bottom:12px;
    font-size:13px;
}

.status-active{
    background:#e8f8f2;
    color:#087957;
}

.status-expired{
    background:#ffeded;
    color:#c62828;
}

.plan{
    border:1px solid #ddd;
    border-radius:12px;
    padding:16px;
    margin-bottom:12px;
    text-align:center;
}

.plan h3{
    color:#0b9e78;
    margin-bottom:7px;
}

.price{
    font-size:25px;
    font-weight:bold;
    margin:8px 0;
}

.plan small{
    color:#666;
}

.plan button{
    margin-top:12px;
}

.admin-panel{
    display:none;
    position:fixed;
    inset:0;
    background:#f3f5f7;
    z-index:1000;
    overflow:auto;
}

.admin-head{
    background:#0b9e78;
    color:white;
    padding:16px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.close{
    background:white;
    color:#0b9e78;
    border:0;
    border-radius:7px;
    padding:7px 10px;
    font-weight:bold;
}

.admin-content{
    max-width:480px;
    margin:auto;
    padding:14px;
}

.hidden{
    display:none!important;
}

.note{
    background:#fff8df;
    border:1px solid #f0d46b;
    padding:10px;
    border-radius:8px;
    font-size:12px;
    line-height:1.5;
}

.empty{
    text-align:center;
    color:#777;
    padding:25px;
}

.delete-btn{
    background:#e53935;
    color:white;
    border:0;
    padding:6px 8px;
    border-radius:5px;
    font-size:11px;
}

.edit-btn{
    background:#0b9e78;
    color:white;
    border:0;
    padding:6px 8px;
    border-radius:5px;
    font-size:11px;
}
</style>
</head>

<body>

<div class="app">

<header class="header">
    <div>
        <h1>🏏 Cricket Central</h1>
        <small>Matches • Rankings • Groups</small>
    </div>

    <button class="admin-btn" onclick="openAdmin()">
        ADMIN
    </button>
</header>

<div class="tabs">
    <div class="tab active" onclick="showPage('matches',this)">
        MATCHES
    </div>

    <div class="tab" onclick="showPage('points',this)">
        POINTS TABLE
    </div>

    <div class="tab" onclick="showPage('groups',this)">
        GROUPS
    </div>
</div>


<!-- MATCHES -->

<section id="matches" class="page active">

    <div class="section-title">Upcoming Matches</div>

    <div id="matchesList"></div>

</section>


<!-- POINTS -->

<section id="points" class="page">

    <div class="section-title">Global Rankings</div>

    <div class="card">
        <h3>TEST Rankings</h3>
        <div id="testTable"></div>
    </div>

    <div class="card">
        <h3>ODI Rankings</h3>
        <div id="odiTable"></div>
    </div>

    <div class="card">
        <h3>T20I Rankings</h3>
        <div id="t20Table"></div>
    </div>

</section>


<!-- GROUPS -->

<section id="groups" class="page">

    <div class="section-title">Custom Groups</div>

    <div id="groupsList"></div>

</section>

</div>


<!-- SUBSCRIPTION MODAL -->

<div id="subscriptionModal"
     style="
     display:none;
     position:fixed;
     inset:0;
     background:rgba(0,0,0,.65);
     z-index:2000;
     overflow:auto;
     ">

    <div style="
        background:#f3f5f7;
        min-height:100%;
        max-width:480px;
        margin:auto;
        padding:15px;
    ">

        <div class="card">

            <h2 style="text-align:center;margin-bottom:8px;">
                ⭐ Cricket Central Premium
            </h2>

            <p style="text-align:center;color:#666;font-size:13px;">
                Schedule aur tournament management unlock karein.
            </p>

        </div>


        <div id="subscriptionStatus"></div>


        <div class="plan">

            <h3>7 Days</h3>

            <div class="price">₹8</div>

            <small>7 din ka access</small>

            <button class="btn"
                    onclick="buyPlan('week7')">
                Google Play se Buy karein
            </button>

        </div>


        <div class="plan">

            <h3>15 Days</h3>

            <div class="price">₹10</div>

            <small>15 din ka access</small>

            <button class="btn"
                    onclick="buyPlan('days15')">
                Google Play se Buy karein
            </button>

        </div>


        <div class="plan">

            <h3>6 Months</h3>

            <div class="price">₹300</div>

            <small>6 mahine ka access</small>

            <button class="btn gold"
                    onclick="buyPlan('months6')">
                Google Play se Buy karein
            </button>

        </div>


        <div class="note">
            <b>Important:</b><br>
            Real payment Google Play Billing ke through Android app mein
            process hoga. HTML browser mein payment simulate nahi karega.
        </div>

        <button class="btn gray"
                onclick="closeSubscription()"
                style="margin-top:12px;">
            Close
        </button>

    </div>
</div>



<!-- ADMIN PANEL -->

<div id="adminPanel" class="admin-panel">

    <div class="admin-head">

        <b>⚙️ Admin Panel</b>

        <button class="close"
                onclick="closeAdmin()">
            ✕
        </button>

    </div>


    <div class="admin-content">


        <!-- LOGIN -->

        <div id="loginBox" class="card">

            <h3>Admin Login</h3>

            <input
                type="password"
                id="adminPassword"
                placeholder="Admin Password"
            >

            <button class="btn"
                    onclick="adminLogin()">
                Login
            </button>

        </div>


        <!-- LOCKED ADMIN -->

        <div id="premiumLock" class="card hidden">

            <div class="lock">

                <div class="lock-icon">🔒</div>

                <h3>Premium Required</h3>

                <p>
                    Schedule, Groups aur Admin management use karne ke
                    liye active subscription required hai.
                </p>

                <button class="btn"
                        onclick="openSubscription()">
                    View Plans
                </button>

            </div>

        </div>


        <!-- ADMIN CONTENT -->

        <div id="adminContent" class="hidden">


            <!-- CREATE GROUP -->

            <div class="card">

                <h3>Create Tournament Group</h3>

                <input
                    id="groupName"
                    placeholder="Group Name"
                >

                <select id="groupFormat">

                    <option value="Test">
                        Test
                    </option>

                    <option value="ODI">
                        ODI
                    </option>

                    <option value="T20">
                        T20
                    </option>

                </select>

                <button class="btn"
                        onclick="createGroup()">
                    Create Group
                </button>

            </div>


            <!-- MATCH -->

            <div class="card">

                <h3>Add Match Schedule</h3>

                <input
                    id="matchTeam1"
                    placeholder="Team 1"
                >

                <input
                    id="matchTeam2"
                    placeholder="Team 2"
                >

                <input
                    id="matchTitle"
                    placeholder="Match Title e.g. 1st ODI"
                >

                <input
                    id="matchDate"
                    type="date"
                >

                <input
                    id="matchVenue"
                    placeholder="Venue"
                >

                <button class="btn"
                        onclick="saveMatch()">
                    Save Match
                </button>

            </div>


            <!-- GLOBAL RANKINGS -->

            <div class="card">

                <h3>Update Global Rankings</h3>

                <select id="rankingFormat">

                    <option value="test">
                        Test
                    </option>

                    <option value="odi">
                        ODI
                    </option>

                    <option value="t20">
                        T20I
                    </option>

                </select>

                <input
                    id="rankingTeam"
                    placeholder="Team"
                >

                <input
                    id="rankingRating"
                    type="number"
                    placeholder="Rating"
                >

                <button class="btn"
                        onclick="updateRanking()">
                    Update Ranking
                </button>

            </div>


            <!-- GROUP POINTS -->

            <div class="card">

                <h3>Custom Group Points</h3>

                <select id="pointsGroup"></select>

                <input
                    id="pointsTeam"
                    placeholder="Team"
                >

                <input
                    id="pointsPlayed"
                    type="number"
                    placeholder="Played"
                >

                <input
                    id="pointsWon"
                    type="number"
                    placeholder="Won"
                >

                <input
                    id="pointsLost"
                    type="number"
                    placeholder="Lost"
                >

                <input
                    id="pointsNRR"
                    type="number"
                    step="0.01"
                    placeholder="NRR"
                >

                <button class="btn"
                        onclick="updateGroupPoints()">
                    Update Points
                </button>

            </div>


            <!-- RESET -->

            <div class="card">

                <h3>WTC Test Standings</h3>

                <button class="btn red"
                        onclick="resetWTC()">
                    Reset WTC Test Standings
                </button>

            </div>


            <div class="card">

                <button class="btn gray"
                        onclick="logoutAdmin()">
                    Logout Admin
                </button>

            </div>

        </div>

    </div>

</div>



<script>

/* =========================================================
   STORAGE
========================================================= */

const STORAGE = {

    testTeams:"cc_testTeams",

    odiTeams:"cc_odiTeams",

    t20Teams:"cc_t20Teams",

    matches:"cc_matchesList",

    groups:"cc_customGroups",

    subscription:"cc_subscription"

};



/* =========================================================
   DEFAULT DATA
========================================================= */

const defaultTeams = {

    test:[
        ["India",91.67],
        ["Australia",82.50],
        ["England",76.20],
        ["South Africa",74.80],
        ["New Zealand",70.30]
    ],

    odi:[
        ["India",118],
        ["Australia",112],
        ["South Africa",109],
        ["New Zealand",105],
        ["England",101]
    ],

    t20:[
        ["India",270],
        ["Australia",250],
        ["England",245],
        ["South Africa",238],
        ["New Zealand",230]
    ]

};


function load(key, fallback){

    const data = localStorage.getItem(key);

    if(!data){

        localStorage.setItem(
            key,
            JSON.stringify(fallback)
        );

        return JSON.parse(
            JSON.stringify(fallback)
        );

    }

    try{
        return JSON.parse(data);
    }
    catch{
        return JSON.parse(
            JSON.stringify(fallback)
        );
    }

}



let testTeams = load(
    STORAGE.testTeams,
    defaultTeams.test
);

let odiTeams = load(
    STORAGE.odiTeams,
    defaultTeams.odi
);

let t20Teams = load(
    STORAGE.t20Teams,
    defaultTeams.t20
);

let matches = load(
    STORAGE.matches,
    [
        {
            team1:"India",
            team2:"Australia",
            title:"1st ODI",
            date:"2026-11-22",
            venue:"Wankhede Stadium"
        }
    ]
);

let groups = load(
    STORAGE.groups,
    []
);



/* =========================================================
   SUBSCRIPTION
========================================================= */

/*
    IMPORTANT:

    Browser demo/localStorage subscription is NOT secure.

    Real Google Play entitlement must be returned by
    Android + backend after Google Play purchase verification.
*/

let subscription =
    load(
        STORAGE.subscription,
        {
            active:false,
            plan:"",
            expiry:0
        }
    );


function saveSubscription(){

    localStorage.setItem(
        STORAGE.subscription,
        JSON.stringify(subscription)
    );

}



function isSubscribed(){

    if(!subscription.active){
        return false;
    }

    if(Date.now() >= subscription.expiry){

        subscription.active = false;

        saveSubscription();

        return false;

    }

    return true;

}



function getExpiryText(){

    if(!isSubscribed()){
        return "Expired / No active subscription";
    }

    return new Date(
        subscription.expiry
    ).toLocaleString();

}



function showSubscriptionStatus(){

    const box =
        document.getElementById(
            "subscriptionStatus"
        );

    if(isSubscribed()){

        box.innerHTML = `
            <div class="subscription-status status-active">
                ✅ <b>Premium Active</b><br>
                Plan: ${subscription.plan}<br>
                Expires: ${getExpiryText()}
            </div>
        `;

    }
    else{

        box.innerHTML = `
            <div class="subscription-status status-expired">
                🔒 <b>No Active Subscription</b><br>
                Premium features locked hain.
            </div>
        `;

    }

}



function openSubscription(){

    document.getElementById(
        "subscriptionModal"
    ).style.display="block";

    showSubscriptionStatus();

}



function closeSubscription(){

    document.getElementById(
        "subscriptionModal"
    ).style.display="none";

}



/*
    This function is called by the HTML buttons.

    Android app ke andar:

    window.AndroidBilling.buySubscription("week7")

    jaise native bridge ko call kiya ja sakta hai.
*/

function buyPlan(plan){

    if(
        window.AndroidBilling &&
        typeof window.AndroidBilling.buySubscription === "function"
    ){

        window.AndroidBilling.buySubscription(
            plan
        );

        return;

    }


    alert(
        "Google Play payment ke liye is HTML ko Android app ke andar chalana hoga."
    );

}



/*
    Android app successful purchase verify hone ke baad
    JavaScript ko ye function call kar sakta hai:

    window.onGooglePlaySubscriptionVerified(
        "week7",
        expiryTimestamp
    );
*/

window.onGooglePlaySubscriptionVerified =
function(plan, expiryTimestamp){

    subscription = {

        active:true,

        plan:plan,

        expiry:Number(
            expiryTimestamp
        )

    };

    saveSubscription();

    showSubscriptionStatus();

    alert(
        "✅ Subscription activated!"
    );

    updateAdminAccess();

};



/*
    Backend se subscription status receive karne
    ke liye function.
*/

window.setSubscriptionStatus =
function(active, plan, expiryTimestamp){

    subscription = {

        active:Boolean(active),

        plan:plan || "",

        expiry:Number(
            expiryTimestamp || 0
        )

    };

    saveSubscription();

    showSubscriptionStatus();

    updateAdminAccess();

};



/* =========================================================
   PREMIUM ACCESS
========================================================= */

function requireSubscription(){

    if(!isSubscribed()){

        openSubscription();

        return false;

    }

    return true;

}



function updateAdminAccess(){

    const lock =
        document.getElementById(
            "premiumLock"
        );

    const content =
        document.getElementById(
            "adminContent"
        );

    if(isSubscribed()){

        lock.classList.add("hidden");

        content.classList.remove("hidden");

    }
    else{

        lock.classList.remove("hidden");

        content.classList.add("hidden");

    }

}



/* =========================================================
   NAVIGATION
========================================================= */

function showPage(page, element){

    document.querySelectorAll(
        ".page"
    ).forEach(
        p => p.classList.remove("active")
    );

    document.getElementById(
        page
    ).classList.add("active");


    document.querySelectorAll(
        ".tab"
    ).forEach(
        t => t.classList.remove("active")
    );

    element.classList.add("active");

}



/* =========================================================
   MATCHES
========================================================= */

function renderMatches(){

    const box =
        document.getElementById(
            "matchesList"
        );

    if(matches.length === 0){

        box.innerHTML =
            `<div class="empty">
                No matches available
             </div>`;

        return;

    }


    box.innerHTML = matches.map(
        (m,index)=>`

        <div class="match">

            <div class="match-title">
                ${m.title}
            </div>

            <div class="teams">

                <div class="team">

                    <img
                        class="flag"
                        src="${getTeamFlagUrl(m.team1)}"
                    >

                    ${m.team1}

                </div>

                <div class="vs">
                    VS
                </div>

                <div class="team">

                    <img
                        class="flag"
                        src="${getTeamFlagUrl(m.team2)}"
                    >

                    ${m.team2}

                </div>

            </div>

            <div class="info">

                📅 ${formatDate(m.date)}
                <br><br>

                📍 ${m.venue}

            </div>

        </div>

        `
    ).join("");

}



function formatDate(date){

    if(!date){
        return "";
    }

    return new Date(
        date+"T00:00:00"
    ).toLocaleDateString(
        "en-IN",
        {
            day:"2-digit",
            month:"short",
            year:"numeric"
        }
    );

}



/* =========================================================
   FLAGS
========================================================= */

function getTeamFlagUrl(team){

    const map = {

        "India":"in",

        "Australia":"au",

        "England":"gb-eng",

        "South Africa":"za",

        "New Zealand":"nz",

        "Pakistan":"pk",

        "Sri Lanka":"lk",

        "Bangladesh":"bd",

        "West Indies":"jm",

        "Afghanistan":"af",

        "Ireland":"ie",

        "Zimbabwe":"zw",

        "Nepal":"np",

        "Scotland":"gb-sct",

        "Netherlands":"nl",

        "United States":"us"

    };


    const code =
        map[team] || "un";


    return `
        https://flagcdn.com/w40/${code}.png
    `;

}



/* =========================================================
   RANKINGS
========================================================= */

function renderTable(data){

    if(!data || data.length===0){

        return `
            <div class="empty">
                No ranking data
            </div>
        `;

    }


    return `

    <table>

        <tr>
            <th>Pos</th>
            <th>Team</th>
            <th>Rating</th>
        </tr>

        ${
            data.map(
                (t,i)=>`

                <tr>

                    <td>${i+1}</td>

                    <td>${t[0]}</td>

                    <td>${t[1]}</td>

                </tr>

                `
            ).join("")
        }

    </table>

    `;

}



function renderRankings(){

    testTeams.sort(
        (a,b)=>b[1]-a[1]
    );

    odiTeams.sort(
        (a,b)=>b[1]-a[1]
    );

    t20Teams.sort(
        (a,b)=>b[1]-a[1]
    );


    document.getElementById(
        "testTable"
    ).innerHTML =
        renderTable(testTeams);


    document.getElementById(
        "odiTable"
    ).innerHTML =
        renderTable(odiTeams);


    document.getElementById(
        "t20Table"
    ).innerHTML =
        renderTable(t20Teams);

}



/* =========================================================
   GROUPS
========================================================= */

function renderGroups(){

    const box =
        document.getElementById(
            "groupsList"
        );


    if(groups.length===0){

        box.innerHTML = `
            <div class="empty">
                No custom groups created.
            </div>
        `;

        return;

    }


    box.innerHTML =
        groups.map(
            (g,i)=>`

            <div class="card">

                <h3>
                    ${g.name}
                </h3>

                <p style="
                    color:#777;
                    font-size:12px;
                    margin:6px 0 12px;
                ">
                    ${g.format}
                </p>

                ${
                    g.teams &&
                    g.teams.length
                    ?
                    `
                    <table>

                        <tr>
                            <th>Pos</th>
                            <th>Team</th>
                            <th>P</th>
                            <th>W</th>
                            <th>L</th>
                            <th>Pts</th>
                            <th>NRR</th>
                        </tr>

                        ${
                            g.teams.map(
                                (t,j)=>`

                                <tr>

                                    <td>${j+1}</td>

                                    <td>${t.team}</td>

                                    <td>${t.p||0}</td>

                                    <td>${t.w||0}</td>

                                    <td>${t.l||0}</td>

                                    <td>${t.pts||0}</td>

                                    <td>${Number(t.nrr||0).toFixed(2)}</td>

                                </tr>

                                `
                            ).join("")
                        }

                    </table>
                    `
                    :
                    `<div class="empty">
                        No teams added
                     </div>`
                }

            </div>

            `
        ).join("");

}



